    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.9",
    "typescript": "~5.7.0"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3",
    "@aws-sdk/lib-dynamodb": "^3",
    "aws-cdk-lib": "2.x",
    "constructs": "^10.0.0",
    "pg": "^8"
  }
